# ============================================================
#  StormWatch — Backend · Variáveis de ambiente (EXEMPLO)
#  Copie este arquivo para `.env` e preencha os valores reais.
#  NUNCA versione o arquivo `.env` (já está no .gitignore).
#
#  Os valores abaixo são os MESMOS defaults do código
#  (backend/src/config/index.js). Só precisa mudar o que quiser.
# ============================================================

# --- Servidor ---
NODE_ENV=development
PORT=4000

# Origens permitidas para CORS (separadas por vírgula).
# Em produção, coloque APENAS o domínio do seu front-end.
CORS_ORIGINS=http://localhost:5173

# --- Autenticação interna ---
# Chave que o front-end envia no header `x-api-key` para falar com o backend.
# OBRIGATÓRIA (o backend não sobe sem ela). Gere uma forte: `openssl rand -hex 32`
APP_API_KEY=troque-esta-chave-em-producao

# Segredo usado para validar o webhook DE ENTRADA (provedor de raios -> nós),
# caso você use push em vez de polling. Verificado via HMAC.
INBOUND_WEBHOOK_SECRET=troque-este-segredo

# --- Fonte de dados de raios ---
# Valores válidos (chaves do adapter em services/lightning.js):
#   mock       -> simulado, offline (padrão; bom para desenvolver a UI)
#   goesglm    -> NOAA GOES-19 GLM real; EXIGE o serviço Python em ingestor/
#   weatherbug -> feed não-oficial "Spark"; requer WEATHERBUG_SPARK_URL (só p/ teste)
#   xweather   -> STUB (ainda não implementado; lança erro)
#   openweather-> STUB (ainda não implementado; lança erro)
LIGHTNING_PROVIDER=mock

# --- Fonte de previsão do tempo ---
# "openmeteo" = API real, gratuita e sem chave (padrão) | "mock" = offline
FORECAST_PROVIDER=openmeteo

# URL do serviço Python de ingestão GLM (GOES-19 / NOAA).
# É SEMPRE consultado pelo monitor de segurança (veja SAFETY_MONITOR abaixo),
# independente do LIGHTNING_PROVIDER acima.
GLM_SERVICE_URL=http://127.0.0.1:5055

# URL assinada do Spark (WeatherBug) capturada do navegador — APENAS p/ teste.
# Só usada quando LIGHTNING_PROVIDER=weatherbug.
WEATHERBUG_SPARK_URL=

# Raio máximo (km) de descargas consideradas "próximas" (lista lateral + popups).
MAX_DISPLAY_KM=120

# Credenciais das APIs reais (preencha quando implementar os stubs correspondentes).
# Ficam SÓ aqui no servidor — nunca vão para o front-end.
XWEATHER_CLIENT_ID=
XWEATHER_CLIENT_SECRET=
OPENWEATHER_API_KEY=

# --- Ponto monitorado (padrão; o front pode sobrescrever via query lat/lon) ---
MONITOR_LAT=-25.5306
MONITOR_LON=-49.2939
MONITOR_LABEL=Pinheirinho, Curitiba - PR

# --- Regras do monitor de segurança ---
# Raio de SEGURANÇA em km: distância CRÍTICA a partir da qual se considera risco.
# Padrão dos EUA para raios: raio crítico de 8 km.
ALERT_RADIUS_KM=8
# Margem para a incerteza de posição do GLM (~10 km). O gatilho EFETIVO usado
# pelo monitor é ALERT_RADIUS_KM + ALERT_MARGIN_KM (erra para o lado seguro).
ALERT_MARGIN_KM=10
# "Tudo limpo": minutos sem raio na zona antes de liberar as atividades.
# Padrão dos EUA (regra 30-30): 30 minutos.
ALL_CLEAR_MIN=30
# Tempo mínimo entre alertas repetidos (anti-spam), em minutos.
ALERT_COOLDOWN_MIN=10

# --- Loop de monitoramento server-side (fail-safe) ---
# Dado de raios mais antigo que isto (s) => "monitoramento indisponível".
GLM_STALE_SEC=180
# Liga/desliga o monitor de segurança que roda mesmo sem app aberto.
# Se "true" (padrão), o serviço Python (ingestor/) precisa estar no ar — senão
# o estado fica "degraded" (MONITORAMENTO INDISPONÍVEL) mesmo com provider mock.
# Coloque "false" para demonstrar só a UI com mock, sem o ingestor (sem alertas).
SAFETY_MONITOR=true
# Intervalo (s) entre avaliações do monitor de segurança.
SAFETY_TICK_SEC=30

# --- Persistência de raios (marcação no mapa + retenção de dados) ---
# Cada raio fica MARCADO no mapa por este tempo, como ícone de relâmpago.
# Padrão dos EUA: 30 minutos.
MAP_MARKER_TTL_MIN=30
# Máximo de raios EXIBIDOS no mapa (os mais próximos), para manter o mapa limpo.
# Não afeta a avaliação de segurança, que usa o feed completo.
MAP_MAX_MARKERS=10
# RETENÇÃO: os raios ficam armazenados por estas horas e então são APAGADOS
# da aplicação. Padrão pedido: 24 horas.
STRIKE_RETENTION_HOURS=24

# --- Saída de alerta (WEBHOOK GENÉRICO) ---
# URL para onde POSTaremos o alerta. Plugue aqui depois:
#   - n8n / Make / Zapier  (que então fala com o WhatsApp)
#   - WhatsApp Cloud API (via um pequeno proxy seu)
#   - Twilio
# Se vazia, o alerta é apenas registrado no log (não enviado).
ALERT_WEBHOOK_URL=
# Segredo opcional: assinamos o corpo com HMAC-SHA256 no header `x-signature`.
ALERT_WEBHOOK_SECRET=
