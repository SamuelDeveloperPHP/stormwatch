# ============================================================
#  StormWatch — variáveis do docker-compose (PRODUÇÃO)
#  Copie para `.env` e preencha. O `.env` real NÃO é versionado.
# ============================================================

# Host público: um domínio, ou IP.sslip.io, ou nome.duckdns.org
SITE_HOST=stormwatch.duckdns.org

# Chave de API entre front e back. Gere uma forte:
#   openssl rand -hex 32
APP_API_KEY=troque-esta-chave-em-producao

# --- Ponto monitorado (padrão) ---
MONITOR_LAT=-25.5306
MONITOR_LON=-49.2939
MONITOR_LABEL=Pinheirinho, Curitiba - PR
ALERT_RADIUS_KM=8

# --- Alerta por webhook (opcional): n8n / WhatsApp / Twilio ---
ALERT_WEBHOOK_URL=
